<Window x:Class="CorexBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CorexBrowser.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:converters="clr-namespace:CorexBrowser.Converters"
        xmlns:local="clr-namespace:CorexBrowser.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"

        Title="Corex Browser"
        WindowStyle="None"
        AllowsTransparency="true"
        ResizeMode="CanResize"

        WindowStartupLocation="CenterScreen" WindowState="Maximized" Cursor="">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome
        CaptionHeight="0"
        ResizeBorderThickness="6"
        GlassFrameThickness="0"
        UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.InputBindings>
        <KeyBinding Key="T"
                Modifiers="Control"
                Command="{Binding NewTabCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="TopBar">


        <Grid.RowDefinitions>
            <RowDefinition x:Name="TabBarRow" Height="45"/>
            <RowDefinition x:Name="ToolbarRow" Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WINDOW CONTROLS OVERLAY -->
        <Grid Grid.Row="0"
      Panel.ZIndex="999"
      HorizontalAlignment="Right"
      VerticalAlignment="Stretch"
      Width="138">

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,6,0">

                <!-- Minimize -->
                <Button Style="{StaticResource IconButton}"
                Click="Minimize_Click">
                    <Path Data="{StaticResource IconMinimize}"
                  Style="{StaticResource IconPath}"/>
                </Button>

                <!-- Maximize -->
                <Button Style="{StaticResource IconButton}"
                Click="Maximize_Click">
                    <Path Data="{StaticResource IconMaximize}"
                  Style="{StaticResource IconPath}"/>
                </Button>

                <!-- Close -->
                <Button Style="{StaticResource IconButton}"
                Click="Close_Click">
                    <Path Data="{StaticResource IconClose}"
                  Style="{StaticResource IconPath}"/>
                </Button>

            </StackPanel>
        </Grid>
       

        <!-- SEKME BAR -->
        <Grid x:Name="TabBar"
      Grid.Row="0"
      Panel.ZIndex="10"
              Background="#202020"
      MouseLeftButtonDown="TitleBar_MouseDown">



            <DockPanel Margin="8,0,140,0">


                <!-- Sekmeler -->
                <!-- Sekmeler + Yeni Sekme -->
                <ScrollViewer x:Name="TabScrollViewer"
    HorizontalScrollBarVisibility="Hidden"
    VerticalScrollBarVisibility="Disabled"
    PanningMode="HorizontalOnly"
    PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel">




                    <StackPanel Orientation="Horizontal">

                        <!-- Sekmeler -->
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Width="200"
        Height="30"
        Margin="0,0,6,0"
        Padding="8,0"
        CornerRadius="6"
        Background="{Binding IsActive, Converter={StaticResource TabBackgroundConverter}}"
        BorderThickness="0,0,0,2"
        MouseLeftButtonDown="Tab_Click">

                                        <Border.Style>

                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <!-- AKTİF SEKME -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush"
                            Value="#4DA3FF"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#4DA3FF"
                              BlurRadius="8"
                              ShadowDepth="0"
                              Opacity="0.35"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- Favicon -->
                                            <Image Width="16"
       Height="16"
       Margin="0,0,6,0"
       VerticalAlignment="Center"
       Source="{Binding Favicon,
                TargetNullValue=/Assets/Icons/default_tab.png}"/>


                                            <!-- Title -->
                                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>

                                            <!-- Close -->
                                            <Button Grid.Column="2"
                                    Content="×"
                                    Width="18"
                                    Height="18"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource IconButton}"
                                    Click="TabClose_Click"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- + Yeni Sekme (ARTIK DOĞRU YERDE) -->
                        <Button Style="{StaticResource IconButton}"
        Height="32"
        Width="32"
        Margin="4,0,0,0"
        ToolTip="Yeni Sekme (Ctrl+T)"
        Click="NewTab_Click">
                            <Path Data="{StaticResource IconPlus}"
                  Style="{StaticResource IconPath}"/>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,6,0">





                </StackPanel>



            </DockPanel>
        </Grid>

        <!-- Ayırıcı -->
        <Border Grid.Row="0"
                Height="1"
                Background="#2A2A2A"
                VerticalAlignment="Bottom"/>





        <!-- ========================= -->
        <!-- TOOLBAR -->
        <!-- ========================= -->
        <Border x:Name="Toolbar"
                Grid.Row="1"
        Panel.ZIndex="10"
        Background="#303030"
        BorderThickness="0">


            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Group -->
                <StackPanel Orientation="Horizontal" Margin="-9,0,9,0">
                    <!-- Back -->
                    <Button  Click="Back_Click" Style="{StaticResource IconButton}">
                        <Path Data="{StaticResource IconBack}"
                  Style="{StaticResource IconPath}"/>
                    </Button>

                    <!-- Forward -->
                    <Button  Click="Forward_Click" Style="{StaticResource IconButton}">
                        <Path Data="{StaticResource IconForward}"
                  Style="{StaticResource IconPath}"/>
                    </Button>

                    <Button x:Name="RefreshStopButton"
        Click="RefreshStop_Click"
        Style="{StaticResource IconButton}">

                        <Path x:Name="RefreshStopIcon"
          Data="{StaticResource IconRefresh}"
          Style="{StaticResource IconPath}"/>
                    </Button>

                    <!-- Menu -->
                <Button Click="Settings_Click" Style="{StaticResource IconButton}" >
                    <Path Data="{StaticResource IconMenu}"
          Style="{StaticResource IconPath}"/>
                </Button>
                    <ToggleButton x:Name="HistoryButton"
              Width="40"
              Height="40"
              Margin="4,0,0,0"
              Content="🕘"
              FontSize="16"
              Background="Transparent"
              Foreground="White"
                                  Style="{StaticResource IconToggleButton}"
              BorderBrush="{x:Null}" />
                    <ToggleButton x:Name="DownloadsButton"
                                  Style="{StaticResource IconToggleButton}"
              Width="40"
              Height="40"
              Margin="4,0,0,0"
              Content="⬇"
              FontSize="16"
              Background="Transparent"
              Foreground="White"
              BorderBrush="{x:Null}" 
              Click="DownloadsButton_Click"/>

                </StackPanel>
                <!-- Address Bar -->
                <Border Grid.Column="3"
                        Height="35"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,0">

                    <DockPanel LastChildFill="True">
                        <Path Data="{StaticResource IconLock}"
      Width="12"
      Height="12"
      Margin="0,0,8,0"
      Stretch="Uniform"
      Style="{StaticResource IconPath}"
      Opacity="0.85"/>




                        <TextBox x:Name="AddressBar"
         BorderThickness="0"
         Background="Transparent"
         VerticalContentAlignment="Center"
         KeyDown="AddressBar_KeyDown"/>


                    </DockPanel>
                </Border>

               

            </Grid>
            
        </Border>
        <Border Height="1"
        Background="#2A2A2A"
        Grid.Row="0"
        VerticalAlignment="Bottom"/>

        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->
        <!-- WEBVIEW HOST -->
        <Grid Grid.Row="2"
      x:Name="BrowserHost"
               RenderOptions.BitmapScalingMode="HighQuality"
      Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ========================= -->
            <!-- DOWNLOADS POPUP -->
            <!-- ========================= -->
            

        </Grid>
        <!-- SETTINGS OVERLAY -->
        <Grid x:Name="SettingsOverlay"
      Visibility="Collapsed"
      Background="#80000000"
      Panel.ZIndex="100"/>

        <!-- ========================= -->
        <!-- HISTORY POPUP -->
        <!-- ========================= -->
        <Popup IsOpen="{Binding IsChecked, ElementName=HistoryButton}" Loaded="HistoryPopup_Loaded"

       PlacementTarget="{Binding ElementName=HistoryButton}"
       Placement="Bottom"
       StaysOpen="False"
       AllowsTransparency="True">

            <Border Width="380"
        Background="#1E1E1E"
        CornerRadius="8"
        Padding="10"
        BorderBrush="#333"
        BorderThickness="1"
        Opacity="0">

                <Border.RenderTransform>
                    <TranslateTransform Y="-8"/>
                </Border.RenderTransform>


                <StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Başlık -->
                        <TextBlock Text="Geçmiş"
               Foreground="White"
               FontSize="16"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                        <!-- Temizle Butonu -->
                        <Button Grid.Column="1"
            Width="28"
            Height="28"
            ToolTip="Geçmişi Temizle"
            Background="Transparent"
            BorderBrush="{x:Null}"
            Click="ClearHistory_Click">

                            <TextBlock Text="🗑"
                   FontSize="14"
                   Foreground="#CCCCCC"/>
                        </Button>
                    </Grid>


                    <!-- History List -->
                    <ScrollViewer Height="400"
                          VerticalScrollBarVisibility="Auto">

                        <ItemsControl
                    ItemsSource="{x:Static services:HistoryService.Items}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6"
                                    Margin="0,0,0,6"
                                    Background="#2A2A2A"
                                    CornerRadius="4"
                                    MouseLeftButtonUp="HistoryItem_Click">

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding Url}"
                                               Foreground="#AAAAAA"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </StackPanel>

            </Border>
        </Popup>


    </Grid>
    <Window.Resources>
        <converters:DownloadStateToVisibilityConverter
    x:Key="ShowWhenInProgress"
    State="InProgress"/>

        <converters:DownloadStateToVisibilityConverter
    x:Key="ShowWhenInterrupted"
    State="Interrupted"/>

        <converters:DownloadStateToVisibilityConverter
    x:Key="ShowWhenCompleted"
    State="Completed"/>

        <Storyboard x:Key="HistoryPopupOpen">
            <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.15"/>

            <DoubleAnimation
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            From="-8"
            To="0"
            Duration="0:0:0.15"/>
        </Storyboard>

    </Window.Resources>


</Window>
