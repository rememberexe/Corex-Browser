<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== -->
    <!-- CORE COLORS -->
    <!-- ===================== -->

    <Color x:Key="Corex.Background">#1f1f1f</Color>
    <Color x:Key="Corex.Surface">#252525</Color>
    <Color x:Key="Corex.SurfaceLight">#2A2A2A</Color>
    <Color x:Key="Corex.Border">#404040</Color>

    <Color x:Key="Corex.TextPrimary">#E6E6E6</Color>
    <Color x:Key="Corex.TextSecondary">#9A9A9A</Color>

    <Color x:Key="Corex.Accent">#3A7AFE</Color>
    <Color x:Key="Corex.AccentHover">#4C86FF</Color>

    <!-- ===================== -->
    <!-- BRUSHES -->
    <!-- ===================== -->

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Corex.Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Corex.Surface}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource Corex.SurfaceLight}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Corex.Border}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Corex.TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Corex.TextSecondary}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Corex.Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Corex.AccentHover}"/>

    <!-- ===================== -->
    <!-- TEXT -->
    <!-- ===================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ===================== -->
    <!-- BUTTON -->
    <!-- ===================== -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== -->
    <!-- TEXTBOX (Adres Çubuğu için temel) -->
    <!-- ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>

                        <!-- TOGGLE BUTTON (AÇMA KAPAMA) -->
                        <ToggleButton x:Name="ToggleButton"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Focusable="False">

                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                                <Grid>
                                    <!-- Seçili item -->
                                    <ContentPresenter
                                    Margin="12,0,36,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Ok -->
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="Gray"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0"/>
                                </Grid>
                            </Border>
                        </ToggleButton>

                        <!-- DROPDOWN -->
                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">

                            <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4,0,0">

                                <ScrollViewer MaxHeight="200">
                                    <ItemsPresenter/>
                                </ScrollViewer>

                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Hover / Focus -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleButton"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ToggleButton"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
